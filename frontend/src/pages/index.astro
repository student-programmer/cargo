---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FeatureTile from '../components/FeatureTile.astro';
import { MainForm } from '../components/Form/Form.jsx';

const phone = '+7 978 906-62-93';
const phoneDigits = '79789066293';
const phoneHref = `tel:+${phoneDigits}`;
const telegram = '@tazer16';
const tgHref = 'https://t.me/tazer16';
const showRequestForm = false;
const orderHref = showRequestForm ? '#zayavka' : phoneHref;

const fleet = [
  { name: 'Грузовик 10 т', price: '7 000 ₽', hourly: '4 000 ₽' },
  { name: 'Грузовик 15 т', price: '10 000 ₽', hourly: '4 500 ₽' },
  { name: 'Грузовик 20 т', price: '15 000 ₽', hourly: '5 000 ₽' },
  { name: 'Длинномер', price: '15 000 ₽', hourly: '4 000 ₽' },
];

const routes = [
  { from: 'Симферополь', to: 'Севастополь', km: '80 км', time: '1,5 ч' },
  { from: 'Симферополь', to: 'Ялта', km: '85 км', time: '1,5 ч' },
  { from: 'Симферополь', to: 'Евпатория', km: '70 км', time: '1 ч' },
  { from: 'Симферополь', to: 'Феодосия', km: '115 км', time: '2 ч' },
  { from: 'Симферополь', to: 'Керчь', km: '210 км', time: '3 ч' },
  { from: 'Севастополь', to: 'Судак', km: '160 км', time: '2,5 ч' },
];

const cities = [
  { name: 'Керчь', icon: 'map-pin', hub: false },
  { name: 'Феодосия', icon: 'map-pin', hub: false },
  { name: 'Симферополь', icon: 'warehouse', hub: true },
  { name: 'Ялта', icon: 'map-pin', hub: false },
  { name: 'Севастополь', icon: 'map-pin', hub: false },
];
---

<Layout>
  <div style="max-width:100%;overflow-x:hidden">

    <!-- HEADER -->
    <header class="site-header">
      <div class="eu-container header-inner">
        <a href="#top" class="brand-link">
          <span class="brand-icon">
            <Icon name="truck" size={22} />
          </span>
          <span class="brand-text">
            <b class="brand-name">КрымГруз</b>
            <span class="brand-sub">Грузоперевозки по Крыму</span>
          </span>
        </a>
        <nav class="header-nav">
          <a href="#fleet">Тарифы</a>
          <a href="#routes">Маршруты</a>
          <a href="#steps">Как работаем</a>
        </nav>
        <a href={phoneHref} class="btn-solar header-btn">
          <Icon name="phone" size={16} />
          <span>Позвонить</span>
        </a>
      </div>
    </header>

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="eu-container hero-grid">
        <div class="hero-text">
          <span class="eyebrow" style="color:var(--solar-400)">
            Грузоперевозки по всему Крыму
          </span>
          <h1 class="hero-h1">Перевезём груз по Крыму за один день</h1>
          <p class="hero-desc">
            Грузовики на 10, 15 и 20 тонн и длинномеры. Подаём машину от 40 минут
            в Симферополе, Севастополе и Ялте.
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <b class="stat-value" style="color:var(--solar-400)">от 4 000 ₽</b>
              <span class="stat-label">за час по городу</span>
            </div>
            <div class="stat-item">
              <b class="stat-value">40 мин</b>
              <span class="stat-label">подача по городу</span>
            </div>
            <div class="stat-item">
              <b class="stat-value">7:00–23:00</b>
              <span class="stat-label">без выходных</span>
            </div>
          </div>
          <div class="hero-ctas">
            <a href={phoneHref} class="btn-solar hero-cta-primary">
              <Icon name="phone" size={20} />
              <span>{phone}</span>
            </a>
            <a href="#fleet" class="btn-outline hero-cta-secondary">
              Посмотреть тарифы
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
          <div class="hero-note">
            <Icon name="clock" size={14} />
            <span>Ежедневно 7:00 — 23:00 · Telegram {telegram}</span>
          </div>
        </div>

        <div class="hero-visual">
          <!-- Cities strip -->
          <div class="cities-strip">
            <div class="cities-line"></div>
            {cities.map(city => (
              <div class={`city-node${city.hub ? ' city-hub' : ''}`}>
                <span class="city-icon">
                  <Icon name={city.icon} size={20} />
                </span>
                <span class="city-name">{city.name}</span>
              </div>
            ))}
          </div>

          <!-- Quick stats cards -->
          <div class="hero-cards">
            <div class="hero-card">
              <div class="hero-card-icon">
                <Icon name="truck" size={22} />
              </div>
              <div>
                <div class="hero-card-title">4 вида транспорта</div>
                <div class="hero-card-sub">10 т, 15 т, 20 т, длинномер</div>
              </div>
            </div>
            <div class="hero-card">
              <div class="hero-card-icon">
                <Icon name="map-pin" size={22} />
              </div>
              <div>
                <div class="hero-card-title">Весь Крым</div>
                <div class="hero-card-sub">межгород по договорной цене</div>
              </div>
            </div>
            <div class="hero-card">
              <div class="hero-card-icon">
                <Icon name="package" size={22} />
              </div>
              <div>
                <div class="hero-card-title">Грузчики</div>
                <div class="hero-card-sub">от 500 ₽/ч за чел.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ТРАНСПОРТ -->
    <section class="section section-light" id="fleet">
      <div class="eu-container">
        <div class="section-header">
          <h2>Тарифы на перевозки по городу</h2>
          <p class="section-lead">
            При безналичной оплате с НДС цена договорная.
          </p>
        </div>
        <div class="fleet-grid">
          {fleet.map(v => (
            <div class="fleet-card">
              <div class="fleet-icon-wrap">
                <Icon name="truck" size={26} />
              </div>
              <h3 class="fleet-name">{v.name}</h3>
              <div class="fleet-specs">
                <div class="fleet-spec">
                  <span>Стоимость</span>
                  <b class="spec-val">{v.price}</b>
                </div>
                <div class="fleet-spec">
                  <span>За 1 час</span>
                  <b class="spec-val">{v.hourly}</b>
                </div>
              </div>
              <div class="fleet-footer">
                <a href={orderHref} class="fleet-btn">
                  {showRequestForm ? 'Заказать' : 'Позвонить'}
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </div>
          ))}
        </div>
        <div class="cta-banner">
          <span>Нужна машина прямо сейчас? Диспетчер ответит за 30 секунд.</span>
          <a href={phoneHref} class="btn-dark" style="height:48px;padding:0 20px;font-size:15px">
            <Icon name="phone" size={18} />
            <span>{phone}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- КАК РАБОТАЕМ -->
    <section class="section section-subtle" id="steps">
      <div class="eu-container">
        <h2 class="steps-title">От звонка до выгрузки — четыре шага</h2>
        <div class="steps-grid">
          <FeatureTile icon="phone" title={showRequestForm ? 'Звонок или заявка' : 'Звонок'} step={1}>
            Уточняем груз, адреса и время. Называем цену сразу.
          </FeatureTile>
          <FeatureTile icon="truck" title="Подача машины" step={2}>
            Приезжаем к назначенному часу, по городу — от 40 минут.
          </FeatureTile>
          <FeatureTile icon="package" title="Погрузка" step={3}>
            Грузчики упаковывают и крепят груз ремнями.
          </FeatureTile>
          <FeatureTile icon="map-pin" title="Доставка и оплата" step={4}>
            Выгружаем по адресу. Способ оплаты согласуем при заказе.
          </FeatureTile>
        </div>
      </div>
    </section>

    <!-- МАРШРУТЫ -->
    <section class="section section-inverse" id="routes">
      <div class="eu-container">
        <div class="section-header">
          <h2 style="color:var(--n-0)">Междугородние перевозки по Крыму</h2>
          <p class="section-lead" style="color:rgba(255,255,255,.7)">
            Цена договорная для всех междугородних маршрутов.
          </p>
        </div>
        <div class="routes-list">
          {routes.map(r => (
            <div class="route-row">
              <span class="route-direction">
                <b>{r.from}</b>
                <Icon name="arrow-right" size={16} />
                <b>{r.to}</b>
              </span>
              <span class="route-meta">{r.km} · {r.time}</span>
            </div>
          ))}
        </div>
        <div class="routes-cta">
          <span style="color:rgba(255,255,255,.8)">Позвоните, чтобы узнать стоимость вашего маршрута.</span>
          <a href={phoneHref} class="btn-solar" style="height:52px;padding:0 22px;font-size:15px">
            <Icon name="phone" size={18} />
            <span>{phone}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ПОЧЕМУ МЫ -->
    <section class="section section-light">
      <div class="eu-container why-grid">
        <div class="why-left">
          <span class="eyebrow">Почему нас выбирают</span>
          <h2>Работаем честно и быстро</h2>
          <p style="font-size:15px;line-height:1.6;color:var(--text-muted);max-width:44ch">
            Называем цену до начала работ — она не меняется. Подаём машину
            в срок или предупреждаем заранее.
          </p>
          <a href={orderHref} class="btn-solar why-cta">{showRequestForm ? 'Оставить заявку' : 'Позвонить'}</a>
        </div>
        <div class="why-right">
          <div class="why-card">
            <span class="why-icon">
              <Icon name="clock" size={22} />
            </span>
            <div>
              <h3 style="margin-bottom:6px">Работаем ежедневно 7:00–23:00</h3>
              <p style="font-size:14px;line-height:1.6;color:var(--text-muted)">
                Принимаем заявки и в выходные, и в праздники. Срочная подача
                по городу — от 40 минут.
              </p>
            </div>
          </div>
          <div class="why-card">
            <span class="why-icon">
              <Icon name="shield-check" size={22} />
            </span>
            <div>
              <h3 style="margin-bottom:6px">Цена фиксируется до поездки</h3>
              <p style="font-size:14px;line-height:1.6;color:var(--text-muted)">
                Диспетчер называет стоимость при заказе. Никаких доплат
                по дороге и скрытых тарифов.
              </p>
            </div>
          </div>
          <div class="why-card">
            <span class="why-icon">
              <Icon name="package" size={22} />
            </span>
            <div>
              <h3 style="margin-bottom:6px">Грузчики в команде</h3>
              <p style="font-size:14px;line-height:1.6;color:var(--text-muted)">
                Профессиональные грузчики умеют упаковывать, крепить
                и поднимать на любой этаж.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ФОРМА -->
    {showRequestForm && <section class="section section-subtle" id="zayavka" style="scroll-margin-top:76px">
      <div class="eu-container form-grid">
        <div class="form-left">
          <h2>Перезвоним за 5 минут</h2>
          <p style="font-size:15px;line-height:1.6;color:var(--text-muted);max-width:44ch">
            Оставьте имя и телефон. Диспетчер уточнит детали и назовёт
            цену до начала работ — она не изменится.
          </p>
          <div class="form-contacts">
            <a href={phoneHref} class="form-phone">
              <Icon name="phone" size={22} />
              <span>{phone}</span>
            </a>
            <a href={tgHref} class="form-tg">Telegram {telegram}</a>
            <span class="form-hours">Симферополь · ежедневно 7:00 — 23:00</span>
          </div>
        </div>
        <div class="form-right">
          <MainForm phoneHref={phoneHref} client:load />
        </div>
      </div>
    </section>}

    <!-- FOOTER -->
    <footer class="footer">
      <div class="eu-container footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <span class="footer-logo-icon">
              <Icon name="truck" size={20} />
            </span>
            <b class="footer-logo-name">КрымГруз</b>
          </div>
          <span style="font-size:14px;max-width:30ch;color:rgba(255,255,255,.72)">
            Грузоперевозки по Республике Крым и Севастополю.
            Грузовики на 10, 15 и 20 тонн и длинномеры.
          </span>
        </div>
        <div class="footer-info">
          <span style="font-size:14px;color:rgba(255,255,255,.6)">Симферополь, ул. Киевская, 1</span>
          <span style="font-size:14px;color:rgba(255,255,255,.6)">Ежедневно, 7:00–23:00</span>
        </div>
        <div class="footer-contacts">
          <span class="eyebrow" style="color:var(--solar-400)">Связаться</span>
          <a href={phoneHref} class="footer-phone">
            <Icon name="phone" size={18} />
            <span>{phone}</span>
          </a>
          <a href={tgHref} class="footer-link">Telegram {telegram}</a>
          {showRequestForm && <a href={orderHref} class="footer-link">Оставить заявку</a>}
        </div>
      </div>
      <div class="eu-container footer-bottom">
        <span>© 2026 КрымГруз, Симферополь</span>
        <span>Цены на сайте не являются публичной офертой</span>
      </div>
      <div class="sticky-bar-spacer"></div>
    </footer>

    <!-- STICKY BAR -->
    <div class="sticky-bar">
      <div class="sticky-bar-inner">
        <a href={phoneHref} class="sticky-call">
          <Icon name="phone" size={18} />
          <span>Позвонить</span>
        </a>
        {showRequestForm && <a href={orderHref} class="btn-ghost-navy sticky-form">Заявка</a>}
      </div>
    </div>

  </div>
</Layout>

<style>
/* ── HEADER ── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(6,28,54,.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-inverse);
  color: var(--n-0);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 10px;
  padding-bottom: 10px;
}
.brand-link {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--n-0);
  text-decoration: none;
}
.brand-link:hover { color: var(--solar-400); }
.brand-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--r-md);
  background: var(--solar-500);
  color: var(--navy-900);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand-text { display: flex; flex-direction: column; line-height: 1.1; }
.brand-name {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: 20px;
  letter-spacing: -0.02em;
  color: var(--n-0);
}
.brand-sub {
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.6);
}
.header-nav {
  display: flex;
  gap: 28px;
  font-size: 14px;
  font-weight: 600;
}
.header-nav a { color: rgba(255,255,255,.8); }
.header-nav a:hover { color: var(--solar-400); }
@media (max-width: 860px) { .header-nav { display: none; } }
.header-btn { height: 40px; padding: 0 16px; font-size: 14px; }

/* ── HERO ── */
.hero {
  background: var(--grad-night);
  color: var(--n-0);
  padding: clamp(36px,9vw,88px) 0 clamp(32px,7vw,72px);
}
.hero-grid {
  display: grid;
  gap: clamp(28px,5vw,56px);
  grid-template-columns: repeat(auto-fit, minmax(320px,1fr));
  align-items: center;
}
.hero-text { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
.hero-h1 {
  font-family: var(--font-display);
  font-weight: 900;
  letter-spacing: -0.02em;
  line-height: 1.05;
  font-size: clamp(30px,7.6vw,56px);
  color: var(--n-0);
}
.hero-desc {
  font-size: clamp(15px,4vw,19px);
  line-height: 1.55;
  color: rgba(255,255,255,.74);
  max-width: 42ch;
}
.hero-stats {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
}
.stat-item { display: flex; flex-direction: column; }
.stat-value {
  font-family: var(--font-display);
  font-size: clamp(20px,4.8vw,28px);
  color: var(--n-0);
}
.stat-label { font-size: 13px; color: rgba(255,255,255,.6); }
.hero-ctas { display: flex; flex-direction: column; gap: 10px; }
.hero-cta-primary {
  height: 56px;
  padding: 0 24px;
  font-size: clamp(16px,4.4vw,20px);
  font-family: var(--font-display);
}
.hero-cta-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 52px;
  padding: 0 24px;
  font-size: 15px;
  border: 1px solid rgba(255,255,255,.3);
  border-radius: var(--r-control);
  color: var(--n-0);
  font-weight: var(--fw-bold);
  transition: var(--t-hover);
  text-decoration: none;
}
.hero-cta-secondary:hover { background: rgba(255,255,255,.08); color: var(--n-0); }
.hero-note {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255,255,255,.55);
}

/* ── HERO VISUAL ── */
.hero-visual { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

.cities-strip {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20px 16px;
  border-radius: var(--r-card);
  background: var(--navy-800);
  border: 1px solid var(--border-inverse);
}
.cities-line {
  position: absolute;
  top: 44px;
  left: 10%;
  right: 10%;
  height: 2px;
  background: rgba(255,255,255,.22);
}
.city-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  position: relative;
  z-index: 1;
  flex: 1;
  text-align: center;
}
.city-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--navy-900);
  color: var(--n-0);
  border: 2px solid rgba(255,255,255,.35);
}
.city-hub .city-icon {
  background: var(--solar-500);
  color: var(--navy-900);
  border-color: var(--solar-500);
}
.city-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 12px;
  color: rgba(255,255,255,.75);
  white-space: nowrap;
}
.city-hub .city-name { color: var(--solar-400); }

.hero-cards {
  display: grid;
  gap: 10px;
  grid-template-columns: repeat(auto-fit, minmax(min(100%,180px),1fr));
}
.hero-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border-radius: var(--r-card);
  background: var(--navy-800);
  border: 1px solid var(--border-inverse);
  box-shadow: var(--sh-inset-top);
}
.hero-card-icon {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(254,184,19,.14);
  color: var(--solar-400);
}
.hero-card-title { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--n-0); }
.hero-card-sub { font-size: 12px; color: rgba(255,255,255,.55); margin-top: 2px; }

/* ── SECTIONS ── */
.section { padding: clamp(44px,9vw,96px) 0; }
.section-light { background: var(--surface-page); }
.section-subtle { background: var(--surface-subtle); }
.section-inverse { background: var(--surface-inverse); color: var(--n-0); }
.section-header { display: flex; flex-direction: column; gap: 10px; margin-bottom: clamp(20px,4vw,32px); }
.section-header h2 { font-weight: 900; font-size: clamp(26px,6.4vw,40px); }
.section-lead { font-size: 15px; line-height: 1.55; color: var(--text-muted); max-width: 56ch; }

/* ── FLEET ── */
.fleet-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(auto-fit, minmax(min(100%,240px),1fr));
  margin-bottom: 16px;
}
.fleet-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 22px;
  border-radius: var(--r-card);
  background: var(--n-0);
  border: 1px solid var(--border-subtle);
